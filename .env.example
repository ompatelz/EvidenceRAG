# Non-secret local intake settings. Copy to your shell environment as needed;
# this file is documentation and is not loaded automatically.
EVIDENCERAG_ARTIFACT_ROOT=artifacts
EVIDENCERAG_MAX_UPLOAD_BYTES=10485760
EVIDENCERAG_UPLOAD_CHUNK_BYTES=65536
EVIDENCERAG_MAX_PDF_PAGES=200
EVIDENCERAG_MAX_EVIDENCE_UNITS=10000
EVIDENCERAG_RENDER_DPI=144
EVIDENCERAG_MAX_RENDER_PIXELS_PER_PAGE=20000000
EVIDENCERAG_MAX_RENDER_PIXELS_TOTAL=100000000

# Host Python provider: off, openai, openrouter, or codex.
# For OpenRouter set EVIDENCERAG_OPENROUTER_MODEL and inject EVIDENCERAG_OPENROUTER_API_KEY.
# For OpenAI API inject EVIDENCERAG_OPENAI_API_KEY.
# For Codex sign in locally with ChatGPT. On Windows set EVIDENCERAG_CODEX_EXECUTABLE
# to the full path of the native codex.exe if it is not on PATH.
EVIDENCERAG_LIVE_ANSWER_PROVIDER=off

# Optional OCR fallback for pages with no native text. Language data is local;
# nothing is downloaded by ingestion. Use a fresh artifact root for a new profile.
EVIDENCERAG_OCR_ENABLED=false
EVIDENCERAG_OCR_LANGUAGE=eng
# EVIDENCERAG_OCR_TESSDATA=/absolute/path/to/tessdata
